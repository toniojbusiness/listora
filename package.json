{
  "name": "listora",
  "private": true,
  "type": "module",
  "description": "Listora monorepo: iPhone app, API, worker, and shared packages.",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker",
    "infra",
    "apps/admin"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run contract:check && npm run infra:synth && npm run test:unit && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js --max-warnings=0 . && shellcheck scripts/*.sh",
    "typecheck": "tsc --build",
    "contract:generate": "npm run generate --workspace @listora/api-contract",
    "contract:check": "npm run check --workspace @listora/api-contract",
    "infra:synth": "npm run synth --workspace @listora/infra",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:api": "npm run dev --workspace @listora/api",
    "dev:worker": "npm run dev --workspace @listora/worker",
    "dev:runner": "npm run runner --workspace @listora/worker",
    "dev:fake-marketplace": "npm run fake --workspace @listora/marketplaces",
    "dev:fake-ebay": "npm run fake:ebay --workspace @listora/marketplaces",
    "ebay:sandbox-token": "node --env-file-if-exists=.env packages/marketplaces/src/ebay/sandbox-token.ts",
    "ebay:sandbox-check": "EBAY_SANDBOX_CHECK=required node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project unit packages/marketplaces/src/ebay/sandbox.live.test.ts",
    "dev:fake-site": "npm run fake-site --workspace @listora/automation",
    "db:migrate": "npm run migrate --workspace @listora/db --",
    "admin": "npm run admin --workspace @listora/admin --",
    "eval": "npm run eval --workspace @listora/eval --",
    "corpus:render": "npm run corpus:render --workspace @listora/eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
