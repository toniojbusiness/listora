{
  "name": "@listora/automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser automation for marketplaces without an API (decision D1): the headless-Chromium runner, its safety rules (pacing, rate limits, challenge detection, redaction), the automation adapter base, the Poshmark, Mercari, Depop, and eBay automation adapters, sale-check scheduling, the runner launcher, and the fake marketplace site and the fake Poshmark, Mercari, Depop, and eBay sites used in development and tests.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fake-site": "node --env-file-if-exists=../../.env src/fake-site/cli.ts",
    "fake-poshmark": "node --env-file-if-exists=../../.env src/poshmark/fake/cli.ts",
    "fake-mercari": "node --env-file-if-exists=../../.env src/mercari/fake/cli.ts",
    "fake-depop-site": "node --env-file-if-exists=../../.env src/depop/fake/cli.ts",
    "fake-ebay-site": "node --env-file-if-exists=../../.env src/ebay/fake/cli.ts",
    "phone:bundle": "node src/phone/bundle.ts",
    "depop:taxonomy": "node src/depop/taxonomy/refresh.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1156.0",
    "@listora/connections": "*",
    "@listora/db": "*",
    "@listora/marketplaces": "*",
    "@listora/operations": "*",
    "@listora/pack-check": "*",
    "@listora/push": "*",
    "@listora/sales": "*",
    "@listora/shared": "*",
    "@listora/storage": "*",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@listora/analysis": "*",
    "@listora/testing": "*",
    "@types/pg": "^8.23.1",
    "rolldown": "~1.2.14",
    "sharp": "^0.35.5"
  }
}
