    "TaskStopped92FAA25A": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Unplanned ECS task stops: crashes, exited containers, failed health checks.",
        "EventPattern": {
          "source": [
            "aws.ecs"
          ],
          "detail-type": [
            "ECS Task State Change"
          ],
          "detail": {
            "clusterArn": [
              {
                "Fn::GetStackOutput": {
                  "StackName": "listora-personal-compute",
                  "Region": "us-east-1",
                  "OutputName": "PublishOutputFnGetAttClusterEB0386A7Arn0CAA3DA3"
                }
              }
            ],
            "group": [
              "service:app"
            ],
            "lastStatus": [
              "STOPPED"
            ],
            "stoppedReason": [
              {
                "anything-but": {
                  "prefix": "Scaling activity initiated by"
                }
              }
            ]
          }
        },
        "Name": "listora-personal-task-stopped",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Ref": "Alarms04B5A0BF"
            },
            "Id": "Target0",
            "InputTransformer": {
              "InputPathsMap": {
                "detail-group": "$.detail.group",
                "detail-stoppedReason": "$.detail.stoppedReason",
                "detail-stopCode": "$.detail.stopCode",
                "detail-taskArn": "$.detail.taskArn"
              },
              "InputTemplate": "\"ECS stopped a <detail-group> task in listora-personal: <detail-stoppedReason> (stop code <detail-stopCode>, task <detail-taskArn>).\""
            }
          }
        ]
      }
    },
