{
  "Description": "Listora personal: GitHub OIDC deploy role (bootstrap)",
  "Resources": {
    "GitHubOidcA2A496A3": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Url": "https://token.actions.githubusercontent.com"
      }
    },
    "DeployRole885297C3": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:toniojbusiness@266634719/listora@1431894048:environment:personal",
                  "token.actions.githubusercontent.com:ref": "refs/heads/main",
                  "token.actions.githubusercontent.com:job_workflow_ref": "toniojbusiness/listora/.github/workflows/deploy-personal.yml@refs/heads/main"
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcA2A496A3"
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "GitHub Actions deploys of toniojbusiness/listora to personal",
        "MaxSessionDuration": 3600,
        "RoleName": "listora-personal-github-deploy"
      }
    },
    "DeployRoleDefaultPolicyDC930F96": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Resource": [
                "arn:aws:iam::333333333333:role/cdk-listora-deploy-role-333333333333-us-east-1",
                "arn:aws:iam::333333333333:role/cdk-listora-file-publishing-role-333333333333-us-east-1",
                "arn:aws:iam::333333333333:role/cdk-listora-image-publishing-role-333333333333-us-east-1"
              ],
              "Sid": "UseCdkBootstrapRoles"
            },
            {
              "Action": "ecr:GetAuthorizationToken",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "EcrLogin"
            },
            {
              "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:DescribeImages",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
              ],
              "Effect": "Allow",
              "Resource": [
                "arn:aws:ecr:us-east-1:333333333333:repository/listora/app",
                "arn:aws:ecr:us-east-1:333333333333:repository/listora/runner"
              ],
              "Sid": "PushApplicationImages"
            },
            {
              "Action": [
                "cloudformation:DescribeStacks",
                "cloudformation:ListStackResources"
              ],
              "Effect": "Allow",
              "Resource": "arn:aws:cloudformation:us-east-1:333333333333:stack/listora-personal-*/*",
              "Sid": "ReadStackOutputs"
            },
            {
              "Action": "cloudformation:DescribeStacks",
              "Effect": "Allow",
              "Resource": "arn:aws:cloudformation:us-east-1:333333333333:stack/CDKToolkit-listora/*",
              "Sid": "CheckRestrictedBootstrap"
            },
            {
              "Action": [
                "iam:GetPolicy",
                "iam:GetPolicyVersion"
              ],
              "Effect": "Allow",
              "Resource": [
                "arn:aws:iam::333333333333:policy/listora-personal-cdk-execution",
                "arn:aws:iam::333333333333:policy/listora-personal-role-boundary"
              ],
              "Sid": "CheckExecutionPolicy"
            },
            {
              "Action": "ec2:DescribeAvailabilityZones",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "CheckZones"
            },
            {
              "Action": "ses:GetEmailIdentity",
              "Effect": "Allow",
              "Resource": "arn:aws:ses:us-east-1:333333333333:identity/*",
              "Sid": "CheckSesIdentities"
            },
            {
              "Action": "ecs:RunTask",
              "Condition": {
                "ArnEquals": {
                  "ecs:cluster": "arn:aws:ecs:us-east-1:333333333333:cluster/listora-personal-migrate"
                }
              },
              "Effect": "Allow",
              "Resource": "arn:aws:ecs:us-east-1:333333333333:task-definition/listora-personal-migrate:*",
              "Sid": "RunSchemaMigrations"
            },
            {
              "Action": "ecs:DescribeTasks",
              "Effect": "Allow",
              "Resource": "arn:aws:ecs:us-east-1:333333333333:task/listora-personal-migrate/*",
              "Sid": "WatchSchemaMigrations"
            },
            {
              "Action": [
                "ecs:DescribeServices",
                "ecs:UpdateService"
              ],
              "Effect": "Allow",
              "Resource": "arn:aws:ecs:us-east-1:333333333333:service/listora-personal/*",
              "Sid": "RollServices"
            },
            {
              "Action": "iam:PassRole",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
              },
              "Effect": "Allow",
              "Resource": "arn:aws:iam::333333333333:role/listora-personal-compute-*",
              "Sid": "PassServiceRoles"
            },
            {
              "Action": "ecs:DescribeTaskDefinition",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "ReadTaskDefinitions"
            },
            {
              "Action": "iam:PassRole",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
              },
              "Effect": "Allow",
              "Resource": [
                "arn:aws:iam::333333333333:role/listora-personal-migrate-execution",
                "arn:aws:iam::333333333333:role/listora-personal-migrate-task"
              ],
              "Sid": "PassSchemaMigrationRoles"
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "DeployRoleDefaultPolicyDC930F96",
        "Roles": [
          {
            "Ref": "DeployRole885297C3"
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeployRole885297C3",
          "Arn"
        ]
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/listora/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
