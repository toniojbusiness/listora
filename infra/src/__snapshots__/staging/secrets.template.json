{
  "Description": "Listora staging: KMS token key and app secrets",
  "Resources": {
    "TokenKeyD1D1A236": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "Description": "Listora envelope encryption for marketplace OAuth tokens",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Statement": [
            {
              "Action": "kms:*",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::111111111111:root"
              },
              "Resource": "*"
            }
          ],
          "Version": "2012-10-17"
        },
        "PendingWindowInDays": 30
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain"
    },
    "TokenKeyAlias129AC994": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/listora-staging-tokens",
        "TargetKeyId": {
          "Fn::GetAtt": [
            "TokenKeyD1D1A236",
            "Arn"
          ]
        }
      }
    },
    "SecretanthropicapikeyEBFE9AC9": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Anthropic API key, read only when AI_PROVIDER=anthropic (packages/ai). Placeholder until set by hand.",
        "GenerateSecretString": {},
        "Name": "listora/staging/anthropic-api-key"
      },
      "UpdateReplacePolicy": "Delete",
      "DeletionPolicy": "Delete"
    }
  },
  "Outputs": {
    "PublishOutputFnGetAttTokenKeyD1D1A236ArnDAE12A0D": {
      "Value": {
        "Fn::GetAtt": [
          "TokenKeyD1D1A236",
          "Arn"
        ]
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
